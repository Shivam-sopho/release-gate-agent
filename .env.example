# Copy to .env (git-ignored) and fill in. Never commit real values.

# neatlogs project key (app.neatlogs.com -> project settings). Without it, runs are untraced.
NEATLOGS_API_KEY=

# Optional overrides
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_PROMPT=v1-baseline
# MCP_SERVER_URL=http://127.0.0.1:8791/mcp
# CONTROL_PANEL_URL=http://127.0.0.1:8792
# ANDROID_HOME=~/Library/Android/sdk   (auto-detected for Android Studio installs)

# Tool server only: reproducible failure-recovery runs, e.g. adb_install:1,adb_dump_ui:1
# FAULT_INJECT=
